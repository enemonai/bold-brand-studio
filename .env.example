# # =============================================================================
# # Public site URL (no trailing slash) — OG tags, sitemap, robots.txt
# # =============================================================================
# VITE_SITE_URL=https://bold-brand-studio.vercel.app

# # =============================================================================
# # EmailJS (contact form – client only, exposed via VITE_*)
# # =============================================================================
# VITE_EMAILJS_SERVICE_ID=your_service_id_here
# VITE_EMAILJS_TEMPLATE_ID=your_template_id_here
# VITE_EMAILJS_PUBLIC_KEY=your_public_key_here

# # =============================================================================
# # Crelyst portfolio content sync (build-time only – scripts/sync-content.ts)
# # =============================================================================
# # Base URL of the Crelyst app (no trailing slash). Used by predev/prebuild to fetch
# # GET /api/public/portfolio-case-studies and write src/data/projects.generated.ts.
# # Local: run Crelyst on :3000 first, or use: npx tsx scripts/generate-local-content.ts
# # CRELYST_API_URL=http://localhost:3000
# # Alternative name read by the sync script if CRELYST_API_URL is unset:
# VITE_CRELYST_API_URL=https://your-crelyst-domain.com
